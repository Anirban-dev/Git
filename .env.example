# MiniGit Configuration

# JWT Secret Key (Must be changed in production!)
MINIGIT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Server Host & Port
MINIGIT_SERVER_HOST=0.0.0.0
MINIGIT_SERVER_PORT=3000

# Email Configuration (Gmail only, Required for OTP registration verification)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

