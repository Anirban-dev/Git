# MiniGit Server Configuration

# JWT Secret Key (Must be changed in production!)
MINIGIT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Server Host (default: localhost)
MINIGIT_SERVER_HOST=0.0.0.0

# Server Port (default: 3000)
MINIGIT_SERVER_PORT=3000

# Email Configuration (Gmail only, Required for OTP verification)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
